# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true
RAKITAPP_OPERATOR_EMAILS=operator@example.test
RAKITAPP_NOTIFICATION_EMAIL=operator@example.test

# Optional: enables Google OAuth on the Agent-Native sign-in page.
# When these values are set, clients can use “Simpan dengan Google” to keep
# prototype requests linked to their account.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
